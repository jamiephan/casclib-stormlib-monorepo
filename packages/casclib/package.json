{
  "name": "@jamiephan/casclib",
  "version": "0.1.0",
  "description": "Node.js native bindings for CascLib - A library to read CASC storage from Blizzard games",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamiephan/casclib-stormlib-monorepo.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "tsc && node ../../scripts/generate-esm.js",
    "rebuild": "node-gyp-build && pnpm build",
    "prebuild": "prebuildify --napi --strip",
    "clean": "node-gyp clean && rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm rebuild"
  },
  "keywords": [
    "casc",
    "casclib",
    "blizzard",
    "storage",
    "native",
    "addon"
  ],
  "author": "jamiephan",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.8.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "jest": "^30.4.2",
    "node-gyp": "^13.0.0",
    "prebuildify": "^6.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.1",
    "typescript": "^6.0.3"
  },
  "gypfile": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "prebuilds/",
    "src/",
    "binding.gyp",
    "README.md"
  ]
}
